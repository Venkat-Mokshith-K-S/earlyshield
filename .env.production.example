# Copy to .env (next to docker-compose.yml) for a production deployment.
# Never commit the real .env.

# Database password. Only takes effect when the database volume is first
# created; changing it later requires changing it inside Postgres too.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The https:// address people open in the browser (used for CORS).
PUBLIC_ORIGIN=https://earlyshield.example.org

# Host folder to protect, mounted into the backend as /watched.
WATCH_DIR=./watched_folder

# Folder holding fullchain.pem and privkey.pem for nginx.
TLS_CERT_DIR=./certs

# Optional: Sign in with Google / GitHub (see OAUTH_SETUP.md). Redirect URIs
# to register: <PUBLIC_ORIGIN>/api/v1/auth/oauth/google/callback and .../github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
