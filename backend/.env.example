# Copy this file to .env and fill in real values. Never commit .env itself.

PROJECT_NAME=EarlyShield
ENVIRONMENT=development
DEBUG=True

DATABASE_URL=postgresql+psycopg://earlyshield:earlyshield@postgres:5432/earlyshield_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Sign in with Google / GitHub (optional; see OAUTH_SETUP.md) ---
# Leave a provider's ID empty to hide its button. Register this redirect URI
# with the provider:  <PUBLIC_URL>/api/v1/auth/oauth/<google|github>/callback
PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

LOG_LEVEL=INFO

# --- ML Detection Engine (added when Module 4 is wired in) ---
ML_MODEL_PATH=app/ml_models/ransomware_rf_model.joblib
ML_EXPLAINER_PATH=app/ml_models/shap_explainer.joblib
ML_FEATURE_NAMES_PATH=app/ml_models/feature_names.joblib

# --- Secure Automated Recovery (Module 5) ---
# Must be outside the watched folder.
RECOVERY_VAULT_PATH=recovery_vault
RECOVERY_AUTO_RESPONSE=True
RECOVERY_AUTO_SUSPEND=False
RECOVERY_CONFIDENCE_THRESHOLD=0.50
